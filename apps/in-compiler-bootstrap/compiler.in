import std.fs;
import std.json;
import std.path;
capability fs.read;
capability fs.write;

fn quote(text: String) -> String {
  return json-stringify(text);
}

fn is-skip-line(line: String) -> Bool {
  let text: String = str-trim(line);
  if str-eq(text, "") {
    return true;
  }
  return str-starts-with(text, "#");
}

fn flat-val(parts: [String], start: Int, end: Int, names: String, values: String) -> Int {
  let i: Int = start;
  let left: Int = 0;
  if str-table-has(names, parts[i]) {
    left = str-table-get-int(names, values, parts[i]);
  } else if str-eq(parts[i], "true") {
    left = 1;
  } else if str-eq(parts[i], "false") {
    left = 0;
  } else {
    left = str-to-int(parts[i]);
  }
  i = i + 1;
  while i < end {
    let op: String = parts[i];
    i = i + 1;
    if i > end { return left; }
    let right: Int = 0;
    if str-table-has(names, parts[i]) {
      right = str-table-get-int(names, values, parts[i]);
    } else if str-eq(parts[i], "true") {
      right = 1;
    } else if str-eq(parts[i], "false") {
      right = 0;
    } else {
      right = str-to-int(parts[i]);
    }
    i = i + 1;
    if str-eq(op, "*") {
      left = left * right;
    } else if str-eq(op, "/") {
      left = left / right;
    } else if str-eq(op, "+") {
      left = left + right;
    } else if str-eq(op, "-") {
      left = left - right;
    } else if str-eq(op, "==") {
      if left == right { left = 1; } else { left = 0; }
    } else if str-eq(op, "!=") {
      if left != right { left = 1; } else { left = 0; }
    } else if str-eq(op, "<") {
      if left < right { left = 1; } else { left = 0; }
    } else if str-eq(op, ">") {
      if left > right { left = 1; } else { left = 0; }
    } else if str-eq(op, "<=") {
      if left <= right { left = 1; } else { left = 0; }
    } else if str-eq(op, ">=") {
      if left >= right { left = 1; } else { left = 0; }
    }
  }
  return left;
}

fn is-op(token: String) -> Bool {
  return str-eq(token, "+") || str-eq(token, "-") || str-eq(token, "*") || str-eq(token, "/") || str-eq(token, "==") || str-eq(token, "!=") || str-eq(token, "<") || str-eq(token, ">") || str-eq(token, "<=") || str-eq(token, ">=");
}

fn emit-int-expr(value: Int) -> String {
  return "{" + quote("kind") + ":" + quote("int") + "," + quote("value") + ":" + to-string(value) + "}";
}

fn emit-call-expr(name: String) -> String {
  return "{" + quote("kind") + ":" + quote("call") + "," + quote("callee") + ":" + quote(name) + "," + quote("args") + ":[]}";
}

fn emit-bool-expr(value: Bool) -> String {
  return "{" + quote("kind") + ":" + quote("bool") + "," + quote("value") + ":" + to-string(value) + "}";
}

fn emit-binary-expr(op: String, lhs: String, rhs: String) -> String {
  return "{" + quote("kind") + ":" + quote("binary") + "," + quote("op") + ":" + quote(op) + "," + quote("lhs") + ":" + lhs + "," + quote("rhs") + ":" + rhs + "}";
}

fn flatten-expr(expr-str: String, names: String, values: String) -> String {
  if !str-contains(expr-str, "(") {
    return expr-str;
  }
  let close: Int = str-index-of(expr-str, ")");
  if close < 0 { return expr-str; }
  let i: Int = close - 1;
  let open: Int = -1;
  while i >= 0 {
    let c: String = str-slice(expr-str, i, i + 1);
    if str-eq(c, "(") {
      open = i;
      i = -1;
    } else {
      i = i - 1;
    }
  }
  if open < 0 { return expr-str; }
  let inner: String = str-slice(expr-str, open + 1, close);
  let inner-parts: [String] = str-tokenize-expr(str-trim(inner));
  let inner-count: Int = array-len(inner-parts);
  if inner-count < 1 { return expr-str; }
  let result: Int = flat-val(inner-parts, 0, inner-count - 1, names, values);
  let before: String = str-slice(expr-str, 0, open);
  let after: String = str-slice(expr-str, close + 1, 999999);
  let flat: String = before + to-string(result) + after;
  return flatten-expr(flat, names, values);
}

fn emit-cmp-int(op: String, lhs: Int, rhs: Int) -> Int {
  if str-eq(op, "==") { if lhs == rhs { return 1; } else { return 0; } }
  if str-eq(op, "!=") { if lhs != rhs { return 1; } else { return 0; } }
  if str-eq(op, "<") { if lhs < rhs { return 1; } else { return 0; } }
  if str-eq(op, ">") { if lhs > rhs { return 1; } else { return 0; } }
  if str-eq(op, "<=") { if lhs <= rhs { return 1; } else { return 0; } }
  if str-eq(op, ">=") { if lhs >= rhs { return 1; } else { return 0; } }
  return 0;
}

fn flat-expr-str(parts: [String], start: Int, end: Int, names: String) -> String {
  let i: Int = start;
  let left-expr: String = emit-int-expr(0);
  let left-val: Int = 0;
  if str-table-has(names, parts[i]) {
    left-expr = emit-call-expr(parts[i]);
    left-val = 0;
  } else if str-eq(parts[i], "true") {
    left-expr = emit-int-expr(1);
    left-val = 1;
  } else if str-eq(parts[i], "false") {
    left-expr = emit-int-expr(0);
    left-val = 0;
  } else {
    left-val = str-to-int(parts[i]);
    left-expr = emit-int-expr(left-val);
  }
  i = i + 1;
  while i < end {
    let op: String = parts[i];
    i = i + 1;
    if i > end { return left-expr; }
    let right-val: Int = 0;
    if str-table-has(names, parts[i]) {
      right-val = 0;
      if i + 1 < end {
        left-expr = emit-binary-expr(op, left-expr, emit-call-expr(parts[i]));
      } else {
        left-expr = emit-binary-expr(op, left-expr, emit-call-expr(parts[i]));
      }
    } else if str-eq(parts[i], "true") {
      right-val = 1;
      left-expr = emit-int-expr(emit-cmp-int(op, left-val, right-val));
    } else if str-eq(parts[i], "false") {
      right-val = 0;
      left-expr = emit-int-expr(emit-cmp-int(op, left-val, right-val));
    } else {
      right-val = str-to-int(parts[i]);
      if str-eq(op, "==") || str-eq(op, "!=") || str-eq(op, "<") || str-eq(op, ">") || str-eq(op, "<=") || str-eq(op, ">=") {
        left-expr = emit-int-expr(emit-cmp-int(op, left-val, right-val));
      } else {
        if i + 1 < end {
          left-expr = emit-binary-expr(op, left-expr, emit-int-expr(right-val));
        } else {
          left-expr = emit-binary-expr(op, left-expr, emit-int-expr(right-val));
        }
      }
      left-val = right-val;
    }
    i = i + 1;
  }
  return left-expr;
}

fn if-arg-str(expr-str: String, arg-num: Int) -> String {
  let trimmed: String = str-trim(expr-str);
  let open: Int = str-index-of(trimmed, "(");
  let close: Int = str-index-of(trimmed, ")");
  if open < 0 { return "0"; }
  let inner: String = "";
  if close < 0 {
    inner = str-trim(str-slice(trimmed, open + 1, 999999));
  } else {
    inner = str-trim(str-slice(trimmed, open + 1, close));
  }
  if arg-num == 0 {
    let comma: Int = str-index-of(inner, ",");
    if comma < 0 { return str-trim(inner); }
    return str-trim(str-slice(inner, 0, comma));
  }
  if arg-num == 1 {
    let comma1: Int = str-index-of(inner, ",");
    if comma1 < 0 { return "0"; }
    let rest: String = str-trim(str-slice(inner, comma1 + 1, 999999));
    let comma2: Int = str-index-of(rest, ",");
    if comma2 < 0 { return str-trim(rest); }
    return str-trim(str-slice(rest, 0, comma2));
  }
  if arg-num == 2 {
    let comma1: Int = str-index-of(inner, ",");
    if comma1 < 0 { return "0"; }
    let rest1: String = str-slice(inner, comma1 + 1, 999999);
    let comma2: Int = str-index-of(rest1, ",");
    if comma2 < 0 { return str-trim(rest1); }
    return str-trim(str-slice(rest1, comma2 + 1, 999999));
  }
  return "0";
}

fn is-if-call(expr-str: String) -> Bool {
  return str-starts-with(str-trim(expr-str), "if(");
}

fn emit-icore-token(token: String, names: String) -> String {
  if str-table-has(names, token) {
    return emit-call-expr(token);
  } else if str-eq(token, "true") {
    return emit-int-expr(1);
  } else if str-eq(token, "false") {
    return emit-int-expr(0);
  } else {
    return emit-int-expr(str-to-int(token));
  }
}

fn resolve-token-value(token: String, names: String, values: String) -> Int {
  if str-table-has(names, token) {
    return str-table-get-int(names, values, token);
  } else if str-eq(token, "true") {
    return 1;
  } else if str-eq(token, "false") {
    return 0;
  } else {
    return str-to-int(token);
  }
}

fn if-line-value(expr-str: String, names: String, values: String) -> Int {
  let cond-arg: String = if-arg-str(expr-str, 0);
  let then-arg: String = if-arg-str(expr-str, 1);
  let else-arg: String = if-arg-str(expr-str, 2);
  let cond-val: Int = resolve-token-value(cond-arg, names, values);
  if cond-val != 0 {
    return resolve-token-value(then-arg, names, values);
  } else {
    return resolve-token-value(else-arg, names, values);
  }
}

fn emit-if-function-expr(name: String, cond: String, then-expr: String, else-expr: String) -> String {
  let q-kind: String = quote("kind");
  let q-function: String = quote("function");
  let q-name: String = quote("name");
  let q-params: String = quote("params");
  let q-return: String = quote("return");
  let q-int: String = quote("Int");
  let q-body: String = quote("body");
  let q-if: String = quote("if");
  let q-cond: String = quote("cond");
  let q-then-body: String = quote("then_body");
  let q-else-body: String = quote("else_body");
  let q-return-stmt: String = quote("return");
  let q-expr: String = quote("expr");
  let then-stmt: String = "{" + q-kind + ":" + q-return-stmt + "," + q-expr + ":" + then-expr + "}";
  let else-stmt: String = "{" + q-kind + ":" + q-return-stmt + "," + q-expr + ":" + else-expr + "}";
  let cond-bool: String = emit-binary-expr("!=", cond, emit-int-expr(0));
  let if-body: String = "{" + q-kind + ":" + q-if + "," + q-cond + ":" + cond-bool + "," + q-then-body + ": [" + then-stmt + "]," + q-else-body + ": [" + else-stmt + "]}";
  return "{" + q-kind + ":" + q-function + "," + q-name + ":" + quote(name) + "," + q-params + ":[]," + q-return + ":" + q-int + "," + q-body + ": [" + if-body + "]}";
}

fn line-supported(line: String, names: String) -> Bool {
  let parts: [String] = str-tokenize-expr(str-trim(line));
  let count: Int = array-len(parts);
  if count < 4 { return false; }
  if !str-eq(parts[0], "let") { return false; }
  if !str-eq(parts[2], "=") { return false; }
  if str-eq(parts[3], "(") { return true; }
  if str-is-int(parts[3]) { return true; }
  if str-table-has(names, parts[3]) { return true; }
  if str-eq(parts[3], "true") || str-eq(parts[3], "false") { return true; }
  if str-eq(parts[3], "if") { return true; }
  return false;
}

fn line-name(line: String) -> String {
  let parts: [String] = str-tokenize-expr(str-trim(line));
  return parts[1];
}

fn line-expr(line: String, names: String, values: String) -> String {
  let eq-idx: Int = str-index-of(line, "=");
  let expr-str: String = "";
  if eq-idx >= 0 {
    expr-str = str-slice(line, eq-idx + 1, 999999);
  } else {
    let parts: [String] = str-tokenize-expr(str-trim(line));
    expr-str = parts[0];
  }
  let flat: String = flatten-expr(expr-str, names, values);
  let parts: [String] = str-tokenize-expr(str-trim(flat));
  let count: Int = array-len(parts);
  if count < 1 { return emit-int-expr(0); }
  return flat-expr-str(parts, 0, count - 1, names);
}

fn line-value(line: String, names: String, values: String) -> Int {
  let eq-idx: Int = str-index-of(line, "=");
  if eq-idx < 0 { return 0; }
  let expr-str: String = str-slice(line, eq-idx + 1, 999999);
  let flat: String = flatten-expr(expr-str, names, values);
  let parts: [String] = str-tokenize-expr(str-trim(flat));
  let count: Int = array-len(parts);
  if count < 1 { return 0; }
  return flat-val(parts, 0, count - 1, names, values);
}

fn emit-int-function-expr(name: String, expr: String) -> String {
  let q-kind: String = quote("kind");
  let q-function: String = quote("function");
  let q-name: String = quote("name");
  let q-params: String = quote("params");
  let q-return: String = quote("return");
  let q-int: String = quote("Int");
  let q-body: String = quote("body");
  let q-return-stmt: String = quote("return");
  let q-expr: String = quote("expr");
  return "{" + q-kind + ":" + q-function + "," + q-name + ":" + quote(name) + "," + q-params + ":[]," + q-return + ":" + q-int + "," + q-body + ":[{" + q-kind + ":" + q-return-stmt + "," + q-expr + ":" + expr + "}]}";
}

fn emit-int-function(name: String, value: Int) -> String {
  return emit-int-function-expr(name, emit-int-expr(value));
}

fn emit-program-with-decls(decls: String, final-name: String) -> String {
  let q-version: String = quote("icoreVersion");
  let q-decls: String = quote("decls");
  let main-decl: String = emit-int-function-expr("main", emit-call-expr(final-name));
  return "{" + q-version + ":2," + q-decls + ":[" + decls + "," + main-decl + "]}";
}

fn emit-unsupported-diagnostic(reason: String, line: String) -> String {
  return "{" + quote("code") + ":" + quote("INBOOT001") + "," + quote("severity") + ":" + quote("error") + "," + quote("reason") + ":" + quote(reason) + "," + quote("line") + ":" + quote(line) + "}";
}

fn compile-source(source: String) -> String {
  let lines: [String] = str-split-lines(source);
  let count: Int = array-len(lines);
  if count < 1 {
    return "{}";
  }
  let i: Int = 0;
  let final-name: String = "";
  let current-name: String = "";
  let current-value: Int = 0;
  let decls: String = "";
  let names: String = "";
  let values: String = "";
  while i < count {
    let line: String = str-trim(lines[i]);
    if is-skip-line(line) {
      i = i + 1;
    } else if str-contains(line, "let") && str-contains(line, "=") {
      if !line-supported(line, names) {
        return "{}";
      }
      current-name = line-name(line);
      let eq-idx: Int = str-index-of(line, "=");
      let expr-part: String = str-trim(str-slice(line, eq-idx + 1, 999999));
      if is-if-call(expr-part) {
        current-value = if-line-value(expr-part, names, values);
        let cond-tok: String = if-arg-str(expr-part, 0);
        let then-tok: String = if-arg-str(expr-part, 1);
        let else-tok: String = if-arg-str(expr-part, 2);
        let cond-expr: String = emit-icore-token(cond-tok, names);
        let then-expr: String = emit-icore-token(then-tok, names);
        let else-expr: String = emit-icore-token(else-tok, names);
        let if-func: String = emit-if-function-expr(current-name, cond-expr, then-expr, else-expr);
        if str-eq(decls, "") {
          decls = if-func;
        } else {
          decls = decls + "," + if-func;
        }
      } else {
        current-value = line-value(line, names, values);
        let current-expr: String = line-expr(line, names, values);
        if str-eq(decls, "") {
          decls = emit-int-function-expr(current-name, current-expr);
        } else {
          decls = decls + "," + emit-int-function-expr(current-name, current-expr);
        }
      }
      names = names + current-name + "|";
      values = values + to-string(current-value) + "|";
      i = i + 1;
    } else {
      final-name = line;
      i = i + 1;
    }
  }
  if str-table-has(names, final-name) {
    return emit-program-with-decls(decls, final-name);
  }
  return "{}";
}

fn main() -> String {
  let path: String = path-join("apps/in-compiler-bootstrap", "sample.expr");
  let source: String = read-file(path);
  let icore: String = compile-source(source);
  let ok: Bool = write-file("/tmp/in-compiler-bootstrap-generated.icore", icore);
  if str-contains(icore, "decls") {
    return icore;
  }
  let diag-ok: Bool = write-file("/tmp/in-compiler-bootstrap-diagnostic.json", emit-unsupported-diagnostic("unsupported-source", source));
  return icore;
}
