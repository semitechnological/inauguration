import std.fs;
import std.json;
import std.path;
capability fs.read;
capability fs.write;

fn quote(text: String) -> String {
  return json_stringify(text);
}

fn is_skip_line(line: String) -> Bool {
  let text: String = str_trim(line);
  if str_eq(text, "") {
    return true;
  }
  return str_starts_with(text, "#");
}

fn flat_val(parts: [String], start: Int, end: Int, names: String, values: String) -> Int {
  let i: Int = start;
  let left: Int = 0;
  if str_table_has(names, parts[i]) {
    left = str_table_get_int(names, values, parts[i]);
  } else if str_eq(parts[i], "true") {
    left = 1;
  } else if str_eq(parts[i], "false") {
    left = 0;
  } else {
    left = str_to_int(parts[i]);
  }
  i = i + 1;
  while i < end {
    let op: String = parts[i];
    i = i + 1;
    if i > end { return left; }
    let right: Int = 0;
    if str_table_has(names, parts[i]) {
      right = str_table_get_int(names, values, parts[i]);
    } else if str_eq(parts[i], "true") {
      right = 1;
    } else if str_eq(parts[i], "false") {
      right = 0;
    } else {
      right = str_to_int(parts[i]);
    }
    i = i + 1;
    if str_eq(op, "*") {
      left = left * right;
    } else if str_eq(op, "/") {
      left = left / right;
    } else if str_eq(op, "+") {
      left = left + right;
    } else if str_eq(op, "-") {
      left = left - right;
    } else if str_eq(op, "==") {
      if left == right { left = 1; } else { left = 0; }
    } else if str_eq(op, "!=") {
      if left != right { left = 1; } else { left = 0; }
    } else if str_eq(op, "<") {
      if left < right { left = 1; } else { left = 0; }
    } else if str_eq(op, ">") {
      if left > right { left = 1; } else { left = 0; }
    } else if str_eq(op, "<=") {
      if left <= right { left = 1; } else { left = 0; }
    } else if str_eq(op, ">=") {
      if left >= right { left = 1; } else { left = 0; }
    }
  }
  return left;
}

fn is_op(token: String) -> Bool {
  return str_eq(token, "+") || str_eq(token, "-") || str_eq(token, "*") || str_eq(token, "/") || str_eq(token, "==") || str_eq(token, "!=") || str_eq(token, "<") || str_eq(token, ">") || str_eq(token, "<=") || str_eq(token, ">=");
}

fn emit_int_expr(value: Int) -> String {
  return "{" + quote("kind") + ":" + quote("int") + "," + quote("value") + ":" + to_string(value) + "}";
}

fn emit_call_expr(name: String) -> String {
  return "{" + quote("kind") + ":" + quote("call") + "," + quote("callee") + ":" + quote(name) + "," + quote("args") + ":[]}";
}

fn emit_bool_expr(value: Bool) -> String {
  return "{" + quote("kind") + ":" + quote("bool") + "," + quote("value") + ":" + to_string(value) + "}";
}

fn emit_binary_expr(op: String, lhs: String, rhs: String) -> String {
  return "{" + quote("kind") + ":" + quote("binary") + "," + quote("op") + ":" + quote(op) + "," + quote("lhs") + ":" + lhs + "," + quote("rhs") + ":" + rhs + "}";
}

fn flatten_expr(expr_str: String, names: String, values: String) -> String {
  if !str_contains(expr_str, "(") {
    return expr_str;
  }
  let close: Int = str_index_of(expr_str, ")");
  if close < 0 { return expr_str; }
  let i: Int = close - 1;
  let open: Int = -1;
  while i >= 0 {
    let c: String = str_slice(expr_str, i, i + 1);
    if str_eq(c, "(") {
      open = i;
      i = -1;
    } else {
      i = i - 1;
    }
  }
  if open < 0 { return expr_str; }
  let inner: String = str_slice(expr_str, open + 1, close);
  let inner_parts: [String] = str_tokenize_expr(str_trim(inner));
  let inner_count: Int = array_len(inner_parts);
  if inner_count < 1 { return expr_str; }
  let result: Int = flat_val(inner_parts, 0, inner_count - 1, names, values);
  let before: String = str_slice(expr_str, 0, open);
  let after: String = str_slice(expr_str, close + 1, 999999);
  let flat: String = before + to_string(result) + after;
  return flatten_expr(flat, names, values);
}

fn flat_expr_str(parts: [String], start: Int, end: Int, names: String) -> String {
  let i: Int = start;
  let left_expr: String = "";
  if str_table_has(names, parts[i]) {
    left_expr = emit_call_expr(parts[i]);
  } else if str_eq(parts[i], "true") {
    left_expr = emit_bool_expr(true);
  } else if str_eq(parts[i], "false") {
    left_expr = emit_bool_expr(false);
  } else {
    left_expr = emit_int_expr(str_to_int(parts[i]));
  }
  i = i + 1;
  while i < end {
    let op: String = parts[i];
    i = i + 1;
    if i > end { return left_expr; }
    let right_expr: String = "";
    if str_table_has(names, parts[i]) {
      right_expr = emit_call_expr(parts[i]);
    } else if str_eq(parts[i], "true") {
      right_expr = emit_bool_expr(true);
    } else if str_eq(parts[i], "false") {
      right_expr = emit_bool_expr(false);
    } else {
      right_expr = emit_int_expr(str_to_int(parts[i]));
    }
    i = i + 1;
    if i < end {
      left_expr = emit_binary_expr(op, left_expr, right_expr);
    } else {
      left_expr = emit_binary_expr(op, left_expr, right_expr);
    }
  }
  return left_expr;
}

fn line_supported(line: String, names: String) -> Bool {
  let parts: [String] = str_tokenize_expr(str_trim(line));
  let count: Int = array_len(parts);
  if count < 4 { return false; }
  if !str_eq(parts[0], "let") { return false; }
  if !str_eq(parts[2], "=") { return false; }
  if str_eq(parts[3], "(") { return true; }
  if str_is_int(parts[3]) { return true; }
  if str_table_has(names, parts[3]) { return true; }
  if str_eq(parts[3], "true") || str_eq(parts[3], "false") { return true; }
  return false;
}

fn line_name(line: String) -> String {
  let parts: [String] = str_tokenize_expr(str_trim(line));
  return parts[1];
}

fn line_expr(line: String, names: String) -> String {
  let eq_idx: Int = str_index_of(line, "=");
  let expr_str: String = "";
  if eq_idx >= 0 {
    expr_str = str_slice(line, eq_idx + 1, 999999);
  } else {
    let parts: [String] = str_tokenize_expr(str_trim(line));
    expr_str = parts[0];
  }
  let flat: String = flatten_expr(expr_str, names, "");
  let parts: [String] = str_tokenize_expr(str_trim(flat));
  let count: Int = array_len(parts);
  if count < 1 { return emit_int_expr(0); }
  return flat_expr_str(parts, 0, count - 1, names);
}

fn line_value(line: String, names: String, values: String) -> Int {
  let eq_idx: Int = str_index_of(line, "=");
  if eq_idx < 0 { return 0; }
  let expr_str: String = str_slice(line, eq_idx + 1, 999999);
  let flat: String = flatten_expr(expr_str, names, values);
  let parts: [String] = str_tokenize_expr(str_trim(flat));
  let count: Int = array_len(parts);
  if count < 1 { return 0; }
  return flat_val(parts, 0, count - 1, names, values);
}

fn emit_int_function_expr(name: String, expr: String) -> String {
  let q_kind: String = quote("kind");
  let q_function: String = quote("function");
  let q_name: String = quote("name");
  let q_params: String = quote("params");
  let q_return: String = quote("return");
  let q_int: String = quote("Int");
  let q_body: String = quote("body");
  let q_return_stmt: String = quote("return");
  let q_expr: String = quote("expr");
  return "{" + q_kind + ":" + q_function + "," + q_name + ":" + quote(name) + "," + q_params + ":[]," + q_return + ":" + q_int + "," + q_body + ":[{" + q_kind + ":" + q_return_stmt + "," + q_expr + ":" + expr + "}]}";
}

fn emit_int_function(name: String, value: Int) -> String {
  return emit_int_function_expr(name, emit_int_expr(value));
}

fn emit_program_with_decls(decls: String, final_name: String) -> String {
  let q_version: String = quote("icoreVersion");
  let q_decls: String = quote("decls");
  let main_decl: String = emit_int_function_expr("main", emit_call_expr(final_name));
  return "{" + q_version + ":2," + q_decls + ":[" + decls + "," + main_decl + "]}";
}

fn emit_unsupported_diagnostic(reason: String, line: String) -> String {
  return "{" + quote("code") + ":" + quote("INBOOT001") + "," + quote("severity") + ":" + quote("error") + "," + quote("reason") + ":" + quote(reason) + "," + quote("line") + ":" + quote(line) + "}";
}

fn compile_source(source: String) -> String {
  let lines: [String] = str_split_lines(source);
  let count: Int = array_len(lines);
  if count < 1 {
    return "{}";
  }
  let i: Int = 0;
  let final_name: String = "";
  let current_name: String = "";
  let current_value: Int = 0;
  let decls: String = "";
  let names: String = "";
  let values: String = "";
  while i < count {
    let line: String = str_trim(lines[i]);
    if is_skip_line(line) {
      i = i + 1;
    } else if str_contains(line, "let") && str_contains(line, "=") {
      if !line_supported(line, names) {
        return "{}";
      }
      current_name = line_name(line);
      current_value = line_value(line, names, values);
      let current_expr: String = line_expr(line, names);
      if str_eq(decls, "") {
        decls = emit_int_function_expr(current_name, current_expr);
      } else {
        decls = decls + "," + emit_int_function_expr(current_name, current_expr);
      }
      names = names + current_name + "|";
      values = values + to_string(current_value) + "|";
      i = i + 1;
    } else {
      final_name = line;
      i = i + 1;
    }
  }
  if str_table_has(names, final_name) {
    return emit_program_with_decls(decls, final_name);
  }
  return "{}";
}

fn main() -> String {
  let path: String = path_join("apps/in-compiler-bootstrap", "sample.expr");
  let source: String = read_file(path);
  let icore: String = compile_source(source);
  let ok: Bool = write_file("/tmp/in-compiler-bootstrap-generated.icore", icore);
  if str_contains(icore, "decls") {
    return icore;
  }
  let diag_ok: Bool = write_file("/tmp/in-compiler-bootstrap-diagnostic.json", emit_unsupported_diagnostic("unsupported-source", source));
  return icore;
}
