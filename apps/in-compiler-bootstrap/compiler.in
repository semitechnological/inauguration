import std.fs;
import std.json;
import std.path;
capability fs.read;
capability fs.write;

fn quote(text: String) -> String {
  return json_stringify(text);
}

fn line_name(line: String) -> String {
  let parts: [String] = str_tokenize_expr(str_trim(line));
  return parts[1];
}

fn token_value(token: String, known_name: String, known_value: Int) -> Int {
  if str_eq(token, known_name) {
    return known_value;
  }
  return str_to_int(token);
}

fn apply_op(left: Int, op: String, right: Int) -> Int {
  if str_eq(op, "+") {
    return left + right;
  }
  if str_eq(op, "-") {
    return left - right;
  }
  if str_eq(op, "*") {
    return left * right;
  }
  if str_eq(op, "/") {
    return left / right;
  }
  return 0;
}

fn line_value(line: String, known_name: String, known_value: Int) -> Int {
  let parts: [String] = str_tokenize_expr(str_trim(line));
  let count: Int = array_len(parts);
  let left: Int = token_value(parts[3], known_name, known_value);
  if count < 6 {
    return left;
  }
  let op1: String = parts[4];
  let middle: Int = token_value(parts[5], known_name, known_value);
  if count < 8 {
    return apply_op(left, op1, middle);
  }
  let op2: String = parts[6];
  let right: Int = token_value(parts[7], known_name, known_value);
  if str_eq(op2, "*") || str_eq(op2, "/") {
    let rhs: Int = apply_op(middle, op2, right);
    return apply_op(left, op1, rhs);
  }
  let lhs: Int = apply_op(left, op1, middle);
  return apply_op(lhs, op2, right);
}

fn emit_int_function(name: String, value: Int) -> String {
  let q_kind: String = quote("kind");
  let q_function: String = quote("function");
  let q_name: String = quote("name");
  let q_params: String = quote("params");
  let q_return: String = quote("return");
  let q_int: String = quote("Int");
  let q_body: String = quote("body");
  let q_value: String = quote("value");
  let q_return_stmt: String = quote("return");
  return "{" + q_kind + ":" + q_function + "," + q_name + ":" + quote(name) + "," + q_params + ":[]," + q_return + ":" + q_int + "," + q_body + ":[{" + q_kind + ":" + q_return_stmt + "," + q_value + ":" + to_string(value) + "}]}";
}

fn emit_program_with_decls(decls: String, final_value: Int) -> String {
  let q_version: String = quote("icoreVersion");
  let q_decls: String = quote("decls");
  let main_decl: String = emit_int_function("main", final_value);
  return "{" + q_version + ":2," + q_decls + ":[" + decls + "," + main_decl + "]}";
}

fn compile_source(source: String) -> String {
  let lines: [String] = str_split_lines(source);
  let count: Int = array_len(lines);
  if count < 2 {
    return "{}";
  }
  let final_name: String = str_trim(lines[count - 1]);
  let i: Int = 0;
  let current_name: String = "";
  let current_value: Int = 0;
  let final_value: Int = 0;
  let matched_final: Bool = false;
  let decls: String = "";
  while i < count - 1 {
    let line: String = str_trim(lines[i]);
    if str_contains(line, "let") && str_contains(line, "=") {
      let previous_name: String = current_name;
      let previous_value: Int = current_value;
      current_name = line_name(line);
      current_value = line_value(line, previous_name, previous_value);
      if str_eq(decls, "") {
        decls = emit_int_function(current_name, current_value);
      } else {
        decls = decls + "," + emit_int_function(current_name, current_value);
      }
      if str_eq(current_name, final_name) {
        final_value = current_value;
        matched_final = true;
      }
    }
    i = i + 1;
  }
  if matched_final {
    return emit_program_with_decls(decls, final_value);
  }
  return "{}";
}

fn main() -> String {
  let path: String = path_join("apps/in-compiler-bootstrap", "sample.expr");
  let source: String = read_file(path);
  let icore: String = compile_source(source);
  let ok: Bool = write_file("/tmp/in-compiler-bootstrap-generated.icore", icore);
  return icore;
}
