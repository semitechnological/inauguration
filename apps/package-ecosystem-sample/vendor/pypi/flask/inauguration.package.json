{
  "ecosystem": "pypi",
  "name": "flask",
  "version": "vendor/pypi/flask",
  "registry": "path",
  "install_path": "/Users/undivisible/projects/inauguration/apps/package-ecosystem-sample/vendor/pypi/flask",
  "exports": [
    "flask_greet"
  ],
  "bindings": [
    {
      "symbol": "flask_greet",
      "returns": "string",
      "invoke": {
        "program": "python3",
        "args": [
          "-c",
          "from greet import greet; import sys; sys.stdout.write(greet())"
        ]
      }
    }
  ]
}