## python
# Compute fibonacci in Python
def fib(n):
    if n <= 1: return n
    return fib(n-1) + fib(n-2)
print(fib(10))

## javascript
// Compute factorial in JS
function fact(n) { return n <= 1 ? 1 : n * fact(n-1); }
console.log(fact(10));

## rust
// Compute sum in Rust
(1..=100).sum::<i64>()

## .in
// Prime check in inlang
2 + 3 * 4
