// @expect parse: ok
// @expect bytecode: executes
// @expect result: 0

class Calculator {
    value: Int

    fn add(n: Int) -> Int {
        return self.value + n;
    }

    fn sub(n: Int) -> Int {
        return self.value - n;
    }
}

fn main() -> void {
    let c = Calculator { value: 10 };
    let sum = c.add(5);
    let diff = c.sub(3);
    return;
}
