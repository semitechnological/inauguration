// @expect parse: ok
// @expect bytecode: executes
// @expect result: String("ok")

fn might_fail(x: Int) -> void {
    if (x < 0) {
        throw "negative";
    }
    return;
}

fn main() -> String {
    try {
        might_fail(1);
    } catch (e) {
        return "negative";
    }
    return "ok";
}
