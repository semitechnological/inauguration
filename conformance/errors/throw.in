// @expect parse: ok
// Status: DESIGN — throw not yet supported by .in parser.
// Falls back to struct + function pattern.

struct Error {
  String message
  Int code
}

fn fail(msg: String, code: Int) -> Error {
  return Error { message: msg, code: code };
}

fn main() -> void {
  let e: Error = fail("not found", 404);
  return;
}
