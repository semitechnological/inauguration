// @expect parse: ok
// @expect bytecode: executes
// @expect result: String("negative")

fn might-fail(x: Int) -> void {
    if (x < 0) {
        throw "negative";
    }
    return;
}

fn main() -> String {
    try {
        might-fail(-1);
    } catch (e) {
        return "negative";
    }
    return "ok";
}
