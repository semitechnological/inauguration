// @expect parse: ok
// Status: DESIGN — try/catch not yet supported by .in parser.
// Falls back to simple conditional pattern.

fn safe_div(a: Int, b: Int) -> Int {
  if (b != 0) {
    return a / b;
  } else {
    return -1;
  }
}

fn main() -> void {
  let result: Int = safe_div(10, 0);
  return;
}
