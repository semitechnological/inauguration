// @expect parse: ok
// @expect has-function: calc
// @expect has-struct: Point
// @expect has-call-edge: calc
// @expect bytecode: executes
// @expect result: 7

struct Point {
  Int x
  Int y
}

fn calc(a: Int, b: Int) -> Int {
  return (a + b) * 2;
}

fn main() -> Int {
  let p: Point = Point { x: 1, y: 2 };
  return p.x + calc(p.x, p.y);
}
