fn add(a: Int, b: Int) -> Int {
  return a + b;
}

fn greet(name: String) -> String {
  return "Hello";
}

fn main() -> Int {
  let sum: Int = add(1, 2);
  let msg: String = greet("world");
  return add(1, 2);
}
