// @expect parse: ok
// @expect bytecode: executes
// @expect result: String("ok")

fn main() -> String {
  let r: String = str-concat("hello ", "world");
  let eq-true: Bool = str-eq(r, "hello world");
  let has: Bool = str-contains(r, "world");
  if eq-true && has {
    return "ok";
  }
  return "fail";
}
