// @expect parse: ok
// @expect bytecode: executes
// @expect result: String("ok")

fn main() -> String {
  let r: String = str_concat("hello ", "world");
  let eq_true: Bool = str_eq(r, "hello world");
  let has: Bool = str_contains(r, "world");
  if eq_true && has {
    return "ok";
  }
  return "fail";
}
