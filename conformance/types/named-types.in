// @expect parse: ok
// @expect has-struct: Name
// @expect has-function: full_name
// @expect has-call-edge: full_name
// @expect bytecode: executes

struct Name {
  String first
  String last
}

fn full_name(n: Name) -> String {
  return n.last;
}

fn main() -> void {
  let n: Name = Name { first: "hello", last: "world" };
  let s: String = full_name(n);
  return;
}
