// conformance/types/primitive-types.in
// Tests: primitive type usage in declarations and expressions
// Expected: parse ok, graph --json shows Int and String types

fn int_identity(x: Int) -> Int {
  return x;
}

fn string_identity(s: String) -> String {
  return s;
}

fn bool_check(val: Int) -> String {
  if (val) {
    return "true";
  } else {
    return "false";
  }
}

fn main() -> void {
  return;
}
