package inauguration.docs;
module inauguration.docs.build;

import std.io;
import std.process;

capability process.spawn;

fn main() -> void {
  print("inauguration docs-site (inlang)");
  process_run("in execute docs-site/scripts/gen-splash.in --module-id inauguration.docs.gen_splash");
  process_run("bash scripts/build-docs-site.sh");
  print("ok https://inauguration.tsc.hk");
  return;
}