div min-h-screen overflow-x-hidden in-docs-page
	main max-w-[896px] sm:max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 min-w-0
		div flex items-center justify-between gap-3 pt-8 sm:pt-10 pb-6 crepus-entrance crepus-e1
			a href="./index.html" flex items-center gap-3 shrink-0 no-underline crepus-t-text hover:opacity-80
				img src="./static/favicon.svg" alt="" w-9 h-9 shrink-0 rounded-md
				span text-sm font-semibold tracking-tight
					"inauguration"
			span text-xs crepus-t-muted hidden sm:block
				"Docs · hybrid compile · hot reload"

		section mb-12 sm:mb-16 crepus-entrance crepus-e2
			div in-docs-hero p-6 sm:p-10 lg:p-12
				div grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_min(100%,400px)] gap-8 lg:gap-12 items-start
					div max-w-2xl min-w-0
						p in-docs-kicker m-0 mb-3
							"Toolchain"
						h1 text-4xl sm:text-5xl font-semibold crepus-t-text tracking-tight leading-[1.1] mb-5 text-pretty
							"Ship faster Swift workflows"
						p text-lg sm:text-xl crepus-t-muted leading-relaxed m-0 mb-8 max-w-xl
							"Hybrid compiler pipeline, SIL work, SwiftUI hot reload, and the "
							code text-sm px-1.5 py-0.5 rounded border crepus-t-border bg-[var(--cp-elevated)] crepus-t-text
								"in"
							" CLI — with "
							code text-sm px-1.5 py-0.5 rounded border crepus-t-border bg-[var(--cp-elevated)] crepus-t-text
								".in"
							" and Core IR experiments."
						div flex flex-wrap gap-3
							a href="./docs/index.html" no-underline inline-flex items-center gap-2 px-5 py-2.5 rounded-md crepus-t-btn-primary text-sm font-medium
								"Read the docs"
							a href="https://github.com/semitechnological/inauguration" no-underline inline-flex items-center px-5 py-2.5 rounded-md crepus-t-btn-ghost text-sm font-medium rel="noopener noreferrer" target="_blank"
								"View on GitHub"
						div mt-10 flex flex-wrap gap-2
							span in-docs-pill
								"in-cli"
							span in-docs-pill
								"rust-driver"
							span in-docs-pill
								"runtime"
							span in-docs-pill
								".in / Core IR"
					div w-full min-w-0
						div rounded-lg border overflow-hidden crepus-t-border bg-[var(--cp-bg)] shadow-[var(--cp-shadow)]
							div flex items-center gap-2 px-3 py-2.5 border-b crepus-t-border bg-[var(--cp-elevated)]
								span flex gap-1.5 shrink-0
									span w-2.5 h-2.5 rounded-full bg-[#ff5f57]
									span w-2.5 h-2.5 rounded-full bg-[#febc2e]
									span w-2.5 h-2.5 rounded-full bg-[#28c840]
								span text-xs font-mono crepus-t-muted ml-1 truncate
									"zsh"
							pre font-mono text-[12px] sm:text-[13px] leading-relaxed p-4 m-0 crepus-t-pre whitespace-pre overflow-x-auto
								"# Native hybrid build
$ in build --path apps/sample-swiftui

# .in front (no swiftc)
$ in build --path apps/in-sample/hello.in --module-id App

# Full test suite
$ in test"

		section py-10 sm:py-12 border-t crepus-t-border crepus-entrance crepus-e3
			div max-w-3xl mb-8
				p in-docs-kicker m-0 mb-2
					"Focus"
				h2 text-2xl sm:text-3xl font-semibold crepus-t-text tracking-tight m-0 mb-3
					"Roadmap and constraints"
				p text-sm sm:text-base crepus-t-muted m-0 leading-relaxed
					"Architecture notes cover .in v0.2, Core IR lowering, stub SIL, and hybrid_sil behavior (last "
					code text-xs px-1 rounded bg-[var(--cp-elevated)] border crepus-t-border
						"sil @"
					" wins). UI patterns follow "
					a href="https://vercel.com/design/guidelines" no-underline crepus-t-icon border-b border-transparent hover:border-[var(--cp-accent)] rel="noopener noreferrer" target="_blank"
						"Vercel Web Interface Guidelines"
					" where applicable."
			div grid gap-4 sm:grid-cols-2
				div rounded-lg p-5 sm:p-6 crepus-t-card
					h3 text-sm font-semibold crepus-t-text m-0 mb-2
						"Static docs"
					p text-sm crepus-t-muted m-0 leading-relaxed
						"Markdown from the repo is compiled to HTML on each crepus web build. Instrument Sans for UI copy; monospace for code."
				div rounded-lg p-5 sm:p-6 crepus-t-card
					h3 text-sm font-semibold crepus-t-text m-0 mb-2
						"Hermetic checks"
					p text-sm crepus-t-muted m-0 leading-relaxed
						"Scripts exercise the Swift subset and .in samples; CI stays aligned with local expectations."
				div rounded-lg p-5 sm:p-6 crepus-t-card
					h3 text-sm font-semibold crepus-t-text m-0 mb-2
						"Protocol"
					p text-sm crepus-t-muted m-0 leading-relaxed
						"Rust protocol-gen is canonical; V drivers remain for benchmarks and parity tooling."
				div rounded-lg p-5 sm:p-6 crepus-t-card
					h3 text-sm font-semibold crepus-t-text m-0 mb-2
						"Plugins"
					p text-sm crepus-t-muted m-0 leading-relaxed
						"Registry profiles (aurorality, crepuscularity) ship next to the core CLI."

		section py-10 sm:py-12 border-t crepus-t-border crepus-entrance crepus-e4
			div flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8
				div
					h2 text-xl font-semibold crepus-t-text m-0 mb-1
						"Documentation"
					p text-sm crepus-t-muted m-0 max-w-lg
						"Guides live in the repository; symlinks under docs/ expose nested paths to the static generator."
				a href="./docs/index.html" no-underline text-sm font-medium crepus-t-text hover:opacity-80 border-b border-[var(--cp-border)] hover:border-[var(--cp-fg)] transition-colors pb-0.5
					"All pages"
			div grid gap-3 sm:grid-cols-2 lg:grid-cols-3
				a href="./docs/in-language.html" doc-card no-underline crepus-t-text
					span text-xs font-mono crepus-t-muted
						"in-language.md"
					span text-base font-semibold mt-2 block
						".in language"
					span text-sm crepus-t-muted mt-1 block
						"v0 and v0.2 surface"
				a href="./docs/multi-frontend-ir.html" doc-card no-underline crepus-t-text
					span text-xs font-mono crepus-t-muted
						"multi-frontend-ir.md"
					span text-base font-semibold mt-2 block
						"Multi-frontend IR"
					span text-sm crepus-t-muted mt-1 block
						"Unified module"
				a href="./docs/native-swift-master-plan.html" doc-card no-underline crepus-t-text
					span text-xs font-mono crepus-t-muted
						"native-swift-master-plan.md"
					span text-base font-semibold mt-2 block
						"Native Swift plan"
					span text-sm crepus-t-muted mt-1 block
						"Pipeline goals"
				a href="./docs/subset-grammar.html" doc-card no-underline crepus-t-text
					span text-xs font-mono crepus-t-muted
						"subset-grammar.md"
					span text-base font-semibold mt-2 block
						"Swift subset"
					span text-sm crepus-t-muted mt-1 block
						"Contracted syntax"
				a href="./docs/interop-roadmap.html" doc-card no-underline crepus-t-text
					span text-xs font-mono crepus-t-muted
						"interop-roadmap.md"
					span text-base font-semibold mt-2 block
						"Interop roadmap"
					span text-sm crepus-t-muted mt-1 block
						"Future bridges"
				a href="./docs/contributing-hybrid-mirror.html" doc-card no-underline crepus-t-text
					span text-xs font-mono crepus-t-muted
						"contributing-hybrid-mirror.md"
					span text-base font-semibold mt-2 block
						"Hybrid mirror"
					span text-sm crepus-t-muted mt-1 block
						"in-cli ↔ rust-driver"

	footer border-t py-10 crepus-t-border crepus-entrance crepus-e6 bg-[var(--cp-elevated)]
		div max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 footer-row
			div flex flex-col gap-2
				a href="./index.html" flex items-center gap-2 no-underline crepus-t-text hover:opacity-80
					img src="./static/favicon.svg" alt="" w-7 h-7 shrink-0 rounded-md
					span text-sm font-medium
						"inauguration"
				span text-xs crepus-t-muted
					"Built with crepuscularity-web · UI informed by Vercel’s Web Interface Guidelines"
			nav flex flex-wrap gap-x-5 gap-y-2 text-xs crepus-t-muted items-center
				a href="./docs/index.html" no-underline crepus-t-muted hover:text-[var(--cp-fg)] transition-colors
					"Docs"
				a href="https://crates.io/crates/inauguration" no-underline crepus-t-muted hover:text-[var(--cp-fg)] transition-colors rel="noopener noreferrer" target="_blank"
					"Crates.io"
				a href="https://github.com/semitechnological/inauguration" no-underline crepus-t-muted hover:text-[var(--cp-fg)] transition-colors rel="noopener noreferrer" target="_blank"
					"GitHub"

.footer-row flex flex-col sm:flex-row justify-between gap-6 sm:items-center
.doc-card group flex flex-col rounded-lg p-5 transition-shadow duration-200 crepus-t-card hover:shadow-[0_4px_16px_rgba(0,0,0,0.08)]
