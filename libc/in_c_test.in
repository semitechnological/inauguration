package space.kernel.libc
module space.kernel.libc.in-c-test

// Test: .in calling C libc functions via extern human fn (C ABI boundary)
// Self-contained test — no kernel dependencies.
//
// extern human fn maps .in function declarations to C ABI symbols
// in the linked ELF object.

extern human fn c-strlen(s: Int) -> Int
extern human fn c-strcmp(a: Int, b: Int) -> Int
extern human fn c-memcpy(dst: Int, src: Int, n: Int) -> void
extern human fn c-memset(dst: Int, c: Int, n: Int) -> void
extern human fn c-memcmp(a: Int, b: Int, n: Int) -> Int
extern human fn c-atoi(s: Int) -> Int
extern human fn c-abs(x: Int) -> Int
extern human fn c-min(a: Int, b: Int) -> Int
extern human fn c-max(a: Int, b: Int) -> Int
extern human fn c-ispow2(x: Int) -> Int

fn in-strlen(s: Int) -> Int {
  let len = 0
  while load8(s + len) != 0 {
    len = len + 1
  }
  return len
}

fn run-tests() -> Int {
  let failures = 0

  // strlen: .in vs C
  let test-str: Int = "hello libc boundary"
  let in-len = in-strlen(test-str)
  let c-len = c-strlen(test-str)
  if in-len != c-len {
    failures = failures + 1
  }

  // strcmp
  let s1: Int = "abc"
  let s2: Int = "abc"
  let s3: Int = "abd"
  if c-strcmp(s1, s2) != 0 {
    failures = failures + 1
  }
  if c-strcmp(s1, s3) >= 0 {
    failures = failures + 1
  }

  // memcpy + memcmp
  let src: Int = "ABCDEFGH"
  let dst = alloc(16)
  c-memset(dst, 0, 16)
  c-memcpy(dst, src, 8)
  if c-memcmp(dst, src, 8) != 0 {
    failures = failures + 1
  }

  // memset
  c-memset(dst, 65, 4)
  if load8(dst + 0) != 65 || load8(dst + 1) != 65 {
    failures = failures + 1
  }

  // atoi
  if c-atoi("42") != 42 {
    failures = failures + 1
  }
  if c-atoi("-7") != -7 {
    failures = failures + 1
  }

  // abs, min, max, ispow2
  if c-abs(-10) != 10 {
    failures = failures + 1
  }
  if c-min(3, 8) != 3 {
    failures = failures + 1
  }
  if c-max(3, 8) != 8 {
    failures = failures + 1
  }
  if c-ispow2(16) == 0 {
    failures = failures + 1
  }
  if c-ispow2(15) != 0 {
    failures = failures + 1
  }

  return failures
}

fn main() -> Int {
  let f = run-tests()
  return f
}
