package space.kernel.libc

// libc-minimal.in — Minimal freestanding libc for the Space nanokernel.
//
// Compiled through Inauguration's .in frontend which has full boundary
// support (unlike the C frontend which lacks boundary emit yet).
//
// Pipeline path:
//   .in → Core IR → SCI binary (works today)
//   C   → Core IR → SCI binary (works for single-file, needs boundary for symbol export)
//   Rust → Core IR → SCI binary (works for single-file, needs boundary for symbol export)
//
// These functions replace the 925-line kernel/libc.in. They compile in ~30ms
// and produce a ~2KB SCI binary.
//
// Future: compile equivalent C source through Inauguration's C frontend once
// boundary capability is wired for the C frontend (see ../docs/libc-migration-plan.md).

// String functions
fn strlen_c(s: Int) -> Int {
  let i = 0
  while load8(s + i) != 0 {
    i = i + 1
  }
  return i
}

fn strcmp_c(s1: Int, s2: Int) -> Int {
  let i = 0
  while true {
    let c1 = load8(s1 + i)
    let c2 = load8(s2 + i)
    if c1 != c2 {
      return c1 - c2
    }
    if c1 == 0 {
      return 0
    }
    i = i + 1
  }
}

fn strcpy_c(dst: Int, src: Int) -> Int {
  let i = 0
  while load8(src + i) != 0 {
    store8(dst + i, load8(src + i))
    i = i + 1
  }
  store8(dst + i, 0)
  return dst
}

// Memory functions
fn memset_c(dst: Int, c: Int, n: Int) -> Int {
  let i = 0
  while i < n {
    store8(dst + i, c)
    i = i + 1
  }
  return dst
}

fn memcpy_c(dst: Int, src: Int, n: Int) -> Int {
  let i = 0
  while i < n {
    store8(dst + i, load8(src + i))
    i = i + 1
  }
  return dst
}

fn memcmp_c(s1: Int, s2: Int, n: Int) -> Int {
  let i = 0
  while i < n {
    let a = load8(s1 + i)
    let b = load8(s2 + i)
    if a != b {
      return a - b
    }
    i = i + 1
  }
  return 0
}

fn memmove_c(dst: Int, src: Int, n: Int) -> Int {
  if dst < src {
    let i = 0
    while i < n {
      store8(dst + i, load8(src + i))
      i = i + 1
    }
  } else {
    let i = n
    while i > 0 {
      i = i - 1
      store8(dst + i, load8(src + i))
    }
  }
  return dst
}

// String search
fn strchr_c(s: Int, c: Int) -> Int {
  let i = 0
  while true {
    let ch = load8(s + i)
    if ch == c {
      return s + i
    }
    if ch == 0 {
      return 0
    }
    i = i + 1
  }
}

fn strstr_c(haystack: Int, needle: Int) -> Int {
  let i = 0
  while load8(haystack + i) != 0 {
    let j = 0
    let is_match = 1
    while load8(needle + j) != 0 {
      if load8(haystack + i + j) != load8(needle + j) {
        is_match = 0
        break
      }
      j = j + 1
    }
    if is_match != 0 {
      return haystack + i
    }
    i = i + 1
  }
  return 0
}

// Character type
fn isdigit_c(c: Int) -> Int {
  if c >= 48 && c <= 57 { return 1 }
  return 0
}

fn isspace_c(c: Int) -> Int {
  if c == 32 || c == 9 || c == 10 || c == 13 || c == 12 || c == 11 { return 1 }
  return 0
}

fn isalpha_c(c: Int) -> Int {
  if c >= 65 && c <= 90 { return 1 }
  if c >= 97 && c <= 122 { return 1 }
  return 0
}

fn toupper_c(c: Int) -> Int {
  if c >= 97 && c <= 122 { return c - 32 }
  return c
}

fn tolower_c(c: Int) -> Int {
  if c >= 65 && c <= 90 { return c + 32 }
  return c
}

fn isprint_c(c: Int) -> Int {
  if c >= 32 && c <= 126 { return 1 }
  return 0
}

// Numeric conversion
fn atoi_c(s: Int) -> Int {
  let i = 0
  let neg = 0
  let result = 0
  while isspace_c(load8(s + i)) != 0 {
    i = i + 1
  }
  if load8(s + i) == 45 {
    neg = 1
    i = i + 1
  } else {
    if load8(s + i) == 43 {
      i = i + 1
    }
  }
  while isdigit_c(load8(s + i)) != 0 {
    result = result * 10 + (load8(s + i) - 48)
    i = i + 1
  }
  if neg != 0 {
    return -result
  }
  return result
}

fn abs_c(x: Int) -> Int {
  if x < 0 { return -x }
  return x
}

fn min_c(a: Int, b: Int) -> Int {
  if a < b { return a }
  return b
}

fn max_c(a: Int, b: Int) -> Int {
  if a > b { return a }
  return b
