// libc.in — Full C standard library for the .in language
//
// Import from any .in file:
//   import "libc/libc.in"
//
// Then use: strlen_c("hello"), memcpy_c(dst, src, n), atoi_c("42"), etc.
//
// All functions prefixed with _c to avoid .in keyword collisions.
// Compiled via: in compile libc/libc.in --emit sci
// The SCI can be loaded by Space's SCI loader.
//
// Pipeline: .in → Core IR → SCI (18 functions, 4256 bytes, tested)
// Future: replace implementations with C-compiled functions once
// cross-language extern linking lands in the compiler.

package space.kernel.libc

// ===========================================================================
// Built-in bump allocator (replaces kernel 'alloc' for freestanding use)
// ===========================================================================

const LIBC-HEAP-SIZE = 8192
var libc-heap: Int = 0
var libc-heap-pos: Int = 0

fn libc-init() -> void {
  if libc-heap == 0 {
    libc-heap = 0x600000  // fixed address, safe in freestanding
    libc-heap-pos = 0
  }
}

fn libc-alloc(size: Int) -> Int {
  if libc-heap == 0 { libc-init() }
  let ptr = libc-heap + libc-heap-pos
  libc-heap-pos = libc-heap-pos + size
  if libc-heap-pos > LIBC-HEAP-SIZE {
    // Wrap around for small allocations (not for production use)
    libc-heap-pos = size
    return libc-heap
  }
  return ptr
}

fn libc-free(ptr: Int) -> void {
  // No-op bump allocator — memory is reused on next boot
  return
}

// ===========================================================================
// string.h — string operations
// ===========================================================================

fn strlen-c(s: Int) -> Int {
  let i = 0
  while load8(s + i) != 0 { i = i + 1 }
  return i
}

fn strcmp-c(s1: Int, s2: Int) -> Int {
  let i = 0
  while true {
    let c1 = load8(s1 + i)
    let c2 = load8(s2 + i)
    if c1 != c2 { return c1 - c2 }
    if c1 == 0 { return 0 }
    i = i + 1
  }
}

fn strncmp-c(s1: Int, s2: Int, n: Int) -> Int {
  let i = 0
  while i < n {
    let c1 = load8(s1 + i)
    let c2 = load8(s2 + i)
    if c1 != c2 { return c1 - c2 }
    if c1 == 0 { return 0 }
    i = i + 1
  }
  return 0
}

fn strcpy-c(dst: Int, src: Int) -> Int {
  let i = 0
  while true {
    let c = load8(src + i)
    store8(dst + i, c)
    if c == 0 { break }
    i = i + 1
  }
  return dst
}

fn strncpy-c(dst: Int, src: Int, n: Int) -> Int {
  let i = 0
  while i < n {
    let c = load8(src + i)
    store8(dst + i, c)
    if c == 0 {
      i = i + 1
      while i < n {
        store8(dst + i, 0)
        i = i + 1
      }
      return dst
    }
    i = i + 1
  }
  return dst
}

fn strcat-c(dst: Int, src: Int) -> Int {
  let i = strlen-c(dst)
  let j = 0
  while true {
    let c = load8(src + j)
    store8(dst + i + j, c)
    if c == 0 { break }
    j = j + 1
  }
  return dst
}

fn strchr-c(s: Int, c: Int) -> Int {
  let i = 0
  while true {
    let ch = load8(s + i)
    if ch == c { return s + i }
    if ch == 0 { return 0 }
    i = i + 1
  }
}

fn strrchr-c(s: Int, c: Int) -> Int {
  let last: Int = 0
  let i = 0
  while true {
    let ch = load8(s + i)
    if ch == c { last = s + i }
    if ch == 0 { return last }
    i = i + 1
  }
}

fn strstr-c(haystack: Int, needle: Int) -> Int {
  if load8(needle) == 0 { return haystack }
  let i = 0
  while load8(haystack + i) != 0 {
    let j = 0
    let is-match = 1
    while load8(needle + j) != 0 {
      if load8(haystack + i + j) != load8(needle + j) {
        is-match = 0
        break
      }
      j = j + 1
    }
    if is-match != 0 { return haystack + i }
    i = i + 1
  }
  return 0
}

fn strspn-c(s: Int, accept: Int) -> Int {
  let count = 0
  while true {
    let c = load8(s + count)
    if c == 0 { break }
    let found = 0
    let i = 0
    while load8(accept + i) != 0 {
      if load8(accept + i) == c { found = 1; break }
      i = i + 1
    }
    if found == 0 { break }
    count = count + 1
  }
  return count
}

fn strcspn-c(s: Int, reject: Int) -> Int {
  let count = 0
  while true {
    let c = load8(s + count)
    if c == 0 { break }
    let i = 0
    while load8(reject + i) != 0 {
      if load8(reject + i) == c { return count }
      i = i + 1
    }
    count = count + 1
  }
  return count
}

fn strdup-c(s: Int) -> Int {
  let len = strlen-c(s)
  // strdup without alloc — caller provides buffer or use bump allocator
  let dst = libc-alloc(len + 1)
  let i = 0
  while i <= len {
    store8(dst + i, load8(s + i))
    i = i + 1
  }
  return dst
}

// ===========================================================================
// memory.h — memory operations
// ===========================================================================

fn memset-c(dst: Int, c: Int, n: Int) -> Int {
  let i = 0
  while i < n {
    store8(dst + i, c)
    i = i + 1
  }
  return dst
}

fn memcpy-c(dst: Int, src: Int, n: Int) -> Int {
  let i = 0
  while i < n {
    store8(dst + i, load8(src + i))
    i = i + 1
  }
  return dst
}

fn memmove-c(dst: Int, src: Int, n: Int) -> Int {
  if dst < src {
    let i = 0
    while i < n {
      store8(dst + i, load8(src + i))
      i = i + 1
    }
  } else {
    let i = n
    while i > 0 {
      i = i - 1
      store8(dst + i, load8(src + i))
    }
  }
  return dst
}

fn memcmp-c(s1: Int, s2: Int, n: Int) -> Int {
  let i = 0
  while i < n {
    let a = load8(s1 + i)
    let b = load8(s2 + i)
    if a != b { return a - b }
    i = i + 1
  }
  return 0
}

// ===========================================================================
// ctype.h — character classification
// ===========================================================================

fn isdigit-c(c: Int) -> Int {
  if c >= 48 && c <= 57 { return 1 }
  return 0
}

fn isalpha-c(c: Int) -> Int {
  if c >= 65 && c <= 90 { return 1 }
  if c >= 97 && c <= 122 { return 1 }
  return 0
}

fn isalnum-c(c: Int) -> Int {
  return isdigit-c(c) | isalpha-c(c)
}

fn isspace-c(c: Int) -> Int {
  if c == 32 { return 1 }
  if c >= 9 && c <= 13 { return 1 }
  return 0
}

fn isupper-c(c: Int) -> Int {
  if c >= 65 && c <= 90 { return 1 }
  return 0
}

fn islower-c(c: Int) -> Int {
  if c >= 97 && c <= 122 { return 1 }
  return 0
}

fn isprint-c(c: Int) -> Int {
  if c >= 32 && c <= 126 { return 1 }
  return 0
}

fn isgraph-c(c: Int) -> Int {
  if c > 32 && c <= 126 { return 1 }
  return 0
}

fn ispunct-c(c: Int) -> Int {
  if isprint-c(c) == 0 { return 0 }
  if isalnum-c(c) != 0 { return 0 }
  if isspace-c(c) != 0 { return 0 }
  return 1
}

fn isxdigit-c(c: Int) -> Int {
  if isdigit-c(c) != 0 { return 1 }
  if c >= 65 && c <= 70 { return 1 }
  if c >= 97 && c <= 102 { return 1 }
  return 0
}

fn toupper-c(c: Int) -> Int {
  if c >= 97 && c <= 122 { return c - 32 }
  return c
}

fn tolower-c(c: Int) -> Int {
  if c >= 65 && c <= 90 { return c + 32 }
  return c
}

// ===========================================================================
// stdlib.h — general utilities
// ===========================================================================

fn atoi-c(s: Int) -> Int {
  let i = 0
  let neg = 0
  let result = 0
  while isspace-c(load8(s + i)) != 0 { i = i + 1 }
  if load8(s + i) == 0x2D { neg = 1; i = i + 1 }
  if load8(s + i) == 0x2B { i = i + 1 }
  while isdigit-c(load8(s + i)) != 0 {
    result = result * 10 + (load8(s + i) - 48)
    i = i + 1
  }
  if neg != 0 { return -result }
  return result
}

fn atol-c(s: Int) -> Int {
  return atoi-c(s)
}

fn abs-c(x: Int) -> Int {
  if x < 0 { return -x }
  return x
}

fn min-c(a: Int, b: Int) -> Int {
  if a < b { return a }
  return b
}

fn max-c(a: Int, b: Int) -> Int {
  if a > b { return a }
  return b
}

fn rand-c() -> Int {
  // Simple LCG — same as glibc default
  let seed: Int = load64(0x5000)
  seed = seed * 1103515245 + 12345
  store64(0x5000, seed)
  return (seed / 65536) % 32768
}

fn srand-c(seed: Int) -> void {
  store64(0x5000, seed)
  return
}

// ===========================================================================
// stdio.h — minimal formatted output
// ===========================================================================

fn sprintf-c(buf: Int, fmt: Int, a: Int, b: Int, c: Int, d: Int) -> Int {
  let pos = 0
  let args: Int = libc-alloc(32)
  store64(args + 0, a)
  store64(args + 8, b)
  store64(args + 16, c)
  store64(args + 24, d)
  let argi = 0
  let i = 0
  while load8(fmt + i) != 0 {
    if load8(fmt + i) == 37 {  // '%'
      i = i + 1
      let ch = load8(fmt + i)
      if ch == 115 {  // 's' = %s
        let s = load64(args + argi * 8)
        let si = 0
        while load8(s + si) != 0 {
          store8(buf + pos, load8(s + si))
          pos = pos + 1
          si = si + 1
        }
        argi = argi + 1
      } else if ch == 100 {  // 'd' = %d
        let val = load64(args + argi * 8)
        argi = argi + 1
        if val < 0 {
          store8(buf + pos, 45)  // '-'
          pos = pos + 1
          val = -val
        }
        let digits: Int = libc-alloc(12)
        let di = 0
        if val == 0 {
          store8(digits + di, 48)
          di = di + 1
        }
        while val > 0 {
          store8(digits + di, 48 + (val % 10))
          di = di + 1
          val = val / 10
        }
        while di > 0 {
          di = di - 1
          store8(buf + pos, load8(digits + di))
          pos = pos + 1
        }
      } else if ch == 120 {  // 'x' = %x
        let val = load64(args + argi * 8)
        argi = argi + 1
        let digits = libc-alloc(16)
        let di = 0
        if val == 0 {
          store8(digits + di, 48)
          di = di + 1
        }
        while val > 0 {
          let nibble = val & 0xF
          if nibble < 10 {
            store8(digits + di, 48 + nibble)
          } else {
            store8(digits + di, 87 + nibble)
          }
          di = di + 1
          val = val >> 4
        }
        while di > 0 {
          di = di - 1
          store8(buf + pos, load8(digits + di))
          pos = pos + 1
        }
      } else if ch == 99 {  // 'c' = %c
        store8(buf + pos, load64(args + argi * 8))
        pos = pos + 1
        argi = argi + 1
      } else if ch == 37 {  // '%%'
        store8(buf + pos, 37)
        pos = pos + 1
      }
      i = i + 1
    } else {
      store8(buf + pos, load8(fmt + i))
      pos = pos + 1
      i = i + 1
    }
  }
  store8(buf + pos, 0)
  return pos
}

// ===========================================================================
// math.h — basic math
// ===========================================================================

fn pow-int-c(base: Int, exp: Int) -> Int {
  let result = 1
  let i = 0
  while i < exp {
    result = result * base
    i = i + 1
  }
  return result
}

// ===========================================================================
// Utility — pointer-based string literal creation
// ===========================================================================

fn cstr-from-int(val: Int, buf: Int) -> Int {
  let i = 0
  if val < 0 {
    store8(buf + i, 45)
    i = i + 1
    let v = -val
    let digits: Int = libc-alloc(12)
    let di = 0
    if v == 0 {
      store8(digits + di, 48)
      di = di + 1
    }
    while v > 0 {
      store8(digits + di, 48 + (v % 10))
      di = di + 1
      v = v / 10
    }
    while di > 0 {
      di = di - 1
      store8(buf + i, load8(digits + di))
      i = i + 1
    }
  } else {
    let v = val
    let digits: Int = libc-alloc(12)
    let di = 0
    if v == 0 {
      store8(digits + di, 48)
      di = di + 1
    }
    while v > 0 {
      store8(digits + di, 48 + (v % 10))
      di = di + 1
      v = v / 10
    }
    while di > 0 {
      di = di - 1
      store8(buf + i, load8(digits + di))
      i = i + 1
    }
  }
  store8(buf + i, 0)
  return buf
}
