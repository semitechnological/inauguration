// =============================================================================
// POSIX C libc compatibility layer for .in
//
// Implements the standard C libc functions ON TOP of the .in-native std API.
// Null-terminated strings are converted to/from Str slices.
//
// Import: import "libc/posix.in"
//
// This is a compatibility layer — new .in code should use "libc/std.in"
// directly (Str, Result, format, etc.) which is safer and faster.
// =============================================================================
package std.posix

import "std.in"

// ===========================================================================
// string.h — null-terminated string operations
// ===========================================================================

fn strlen(s: Int) -> Int {
    let len = 0
    while load8(s + len) != 0 {
        len = len + 1
    }
    return len
}

fn strcmp(s1: Int, s2: Int) -> Int {
    let i = 0
    while true {
        let c1 = load8(s1 + i)
        let c2 = load8(s2 + i)
        if c1 != c2 { return c1 - c2 }
        if c1 == 0 { return 0 }
        i = i + 1
    }
}

fn strncmp(s1: Int, s2: Int, n: Int) -> Int {
    let i = 0
    while i < n {
        let c1 = load8(s1 + i)
        let c2 = load8(s2 + i)
        if c1 != c2 { return c1 - c2 }
        if c1 == 0 { return 0 }
        i = i + 1
    }
    return 0
}

fn strcpy(dst: Int, src: Int) -> Int {
    let i = 0
    while true {
        let c = load8(src + i)
        store8(dst + i, c)
        if c == 0 { break }
        i = i + 1
    }
    return dst
}

fn strncpy(dst: Int, src: Int, n: Int) -> Int {
    let i = 0
    while i < n && load8(src + i) != 0 {
        store8(dst + i, load8(src + i))
        i = i + 1
    }
    while i < n {
        store8(dst + i, 0)
        i = i + 1
    }
    return dst
}

fn strcat(dst: Int, src: Int) -> Int {
    let dlen = strlen(dst)
    let i = 0
    while true {
        let c = load8(src + i)
        store8(dst + dlen + i, c)
        if c == 0 { break }
        i = i + 1
    }
    return dst
}

fn strchr(s: Int, c: Int) -> Int {
    let i = 0
    while true {
        let ch = load8(s + i)
        if ch == c { return s + i }
        if ch == 0 { return 0 }
        i = i + 1
    }
}

fn strrchr(s: Int, c: Int) -> Int {
    let last: Int = 0
    let i = 0
    while true {
        let ch = load8(s + i)
        if ch == c { last = s + i }
        if ch == 0 { return last }
        i = i + 1
    }
}

fn strstr(haystack: Int, needle: Int) -> Int {
    if load8(needle) == 0 { return haystack }
    let i = 0
    while load8(haystack + i) != 0 {
        let j = 0
        let is_match = 1
        while load8(needle + j) != 0 {
            if load8(haystack + i + j) != load8(needle + j) {
                is_match = 0
                break
            }
            j = j + 1
        }
        if is_match != 0 { return haystack + i }
        i = i + 1
    }
    return 0
}

fn strspn(s: Int, accept: Int) -> Int {
    let count = 0
    while true {
        let c = load8(s + count)
        if c == 0 { break }
        let found = 0
        let i = 0
        while load8(accept + i) != 0 {
            if load8(accept + i) == c { found = 1; break }
            i = i + 1
        }
        if found == 0 { break }
        count = count + 1
    }
    return count
}

fn strcspn(s: Int, reject: Int) -> Int {
    let count = 0
    while true {
        let c = load8(s + count)
        if c == 0 { break }
        let i = 0
        while load8(reject + i) != 0 {
            if load8(reject + i) == c { return count }
            i = i + 1
        }
        count = count + 1
    }
    return count
}

// ===========================================================================
// memory.h
// ===========================================================================

fn memset(dst: Int, c: Int, n: Int) -> Int {
    let i = 0
    while i < n {
        store8(dst + i, c)
        i = i + 1
    }
    return dst
}

fn memcpy(dst: Int, src: Int, n: Int) -> Int {
    let i = 0
    while i < n {
        store8(dst + i, load8(src + i))
        i = i + 1
    }
    return dst
}

fn memmove(dst: Int, src: Int, n: Int) -> Int {
    if dst < src {
        let i = 0
        while i < n {
            store8(dst + i, load8(src + i))
            i = i + 1
        }
    } else {
        let i = n
        while i > 0 {
            i = i - 1
            store8(dst + i, load8(src + i))
        }
    }
    return dst
}

fn memcmp(s1: Int, s2: Int, n: Int) -> Int {
    let i = 0
    while i < n {
        let a = load8(s1 + i)
        let b = load8(s2 + i)
        if a != b { return a - b }
        i = i + 1
    }
    return 0
}

// ===========================================================================
// ctype.h
// ===========================================================================

fn isdigit(c: Int) -> Int {
    if c >= 48 && c <= 57 { return 1 }
    return 0
}

fn isalpha(c: Int) -> Int {
    if c >= 65 && c <= 90 { return 1 }
    if c >= 97 && c <= 122 { return 1 }
    return 0
}

fn isalnum(c: Int) -> Int {
    return isdigit(c) | isalpha(c)
}

fn isspace(c: Int) -> Int {
    if c == 32 { return 1 }
    if c >= 9 && c <= 13 { return 1 }
    return 0
}

fn isupper(c: Int) -> Int {
    if c >= 65 && c <= 90 { return 1 }
    return 0
}

fn islower(c: Int) -> Int {
    if c >= 97 && c <= 122 { return 1 }
    return 0
}

fn isprint(c: Int) -> Int {
    if c >= 32 && c <= 126 { return 1 }
    return 0
}

fn toupper(c: Int) -> Int {
    if c >= 97 && c <= 122 { return c - 32 }
    return c
}

fn tolower(c: Int) -> Int {
    if c >= 65 && c <= 90 { return c + 32 }
    return c
}

// ===========================================================================
// stdlib.h
// ===========================================================================

fn atoi(s: Int) -> Int {
    let i = 0
    let neg = 0
    let result = 0
    while isspace(load8(s + i)) != 0 { i = i + 1 }
    if load8(s + i) == 0x2D { neg = 1; i = i + 1 }
    if load8(s + i) == 0x2B { i = i + 1 }
    while isdigit(load8(s + i)) != 0 {
        result = result * 10 + (load8(s + i) - 48)
        i = i + 1
    }
    if neg != 0 { return -result }
    return result
}

fn atol(s: Int) -> Int {
    return atoi(s)
}

fn abs(x: Int) -> Int {
    if x < 0 { return -x }
    return x
}

fn min(a: Int, b: Int) -> Int {
    if a < b { return a }
    return b
}

fn max(a: Int, b: Int) -> Int {
    if a > b { return a }
    return b
}

fn rand() -> Int {
    let seed: Int = load64(0x5000)
    if seed == 0 { seed = 1 }
    seed = seed * 1103515245 + 12345
    store64(0x5000, seed)
    return (seed / 65536) % 32768
}

fn srand(seed: Int) -> void {
    store64(0x5000, seed)
    return
}
