import std.io;

capability process.stdout;
capability space.boot;
capability space.capability_table;
capability space.component_loader;
capability space.object_graph;
capability space.snapshot;

extern space fn grant_capability(component: String, capability: String) -> Bool requires space.capability_table;
extern space fn load_component(name: String) -> Bool requires space.component_loader;
extern space fn create_object_root(name: String) -> Bool requires space.object_graph;
extern space fn checkpoint_realm(name: String) -> Bool requires space.snapshot;

struct BootStep {
  String name
  String capability
}

fn boot_foundation() -> Bool {
  let supervisor_loaded: Bool = load_component("supervisor")
  let graph_ready: Bool = create_object_root("space.root")
  return graph_ready
}

fn main() -> void {
  print("space boot contract")
  boot_foundation()
  return
}
